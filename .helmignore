# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Common build artifacts
assets/
# CI 与源码包，不属于 chart
deploy/
*.zip
# Java 工程内容只在 git 里，chart 包不需要打包
src/
target/
pom.xml
mvnw
mvnw.cmd
.mvn/
Dockerfile
.dockerignore

